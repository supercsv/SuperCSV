# Timezone variations: real zones, null, empty string, and arbitrary identifiers
Id:int, Zone:timezone

1, UTC
2, "Pacific/Auckland"
3, "America/New_York"
4, "Europe/Berlin"
5, "Asia/Tokyo"
6, "Australia/Sydney"
# empty string (present but blank)
